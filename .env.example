# .env.example dùng chung cho 3 repo (backend, storefront, chatbot): copy thành .env
# (storefront: .env.local) rồi điền giá trị. Không commit file .env thật.
# Tên: CONFIG_<HỆ>_<THUỘC TÍNH>[_<DỊCH VỤ>]. Bí mật >= 32 ký tự.
# Sinh bí mật (trong repo chatbot): npm run settings -- gen jwt_secret

# --- Medusa (backend) ---
CONFIG_POSTGRES_PASSWORD_MEDUSA=
CONFIG_POSTGRES_URL_MEDUSA=
CONFIG_REDIS_URL_MEDUSA=
CONFIG_JWT_SECRET_MEDUSA=
CONFIG_COOKIE_SECRET_MEDUSA=
CONFIG_ENCRYPTION_KEY_MEDUSA=

# --- Chatbot ---
CONFIG_POSTGRES_PASSWORD_CHATBOT=
CONFIG_POSTGRES_URL_CHATBOT=
CONFIG_POSTGRES_URL_CHATBOT_APP=
CONFIG_POSTGRES_URL_CHATBOT_CENTRAL=
CONFIG_REDIS_URL_CHATBOT=
CONFIG_JWT_SECRET_CHATBOT_SESSION=
CONFIG_JWT_SECRET_CHATBOT_ADMIN=
CONFIG_ENCRYPTION_KEY_CHATBOT=
CONFIG_MINIO_HOST=
CONFIG_MINIO_PORT=
CONFIG_MINIO_ACCESS_KEY=
CONFIG_MINIO_SECRET_KEY=
CONFIG_API_CHATBOT_PUBLIC_URL=
SERVICE_PORT=3000

# --- Cổng chạy (đọc từ .env, không ghi cứng) ---
# backend: PORT (API Medusa), CONFIG_ADMIN_PORT (trang admin Vite)
# storefront: PORT (đặt trong .env.local) / chatbot: SERVICE_PORT (ở trên)
CONFIG_ADMIN_PORT=5173

# --- Dùng chung (phải giống hệt giữa các dịch vụ) ---
CONFIG_INTERNAL_SERVICE_KEY=
CONFIG_MEILI_HOST=
CONFIG_MEILI_MASTER_KEY=
CONFIG_MEILI_INDEX=products
CONFIG_TENANT_ID=
CONFIG_PUBLISHABLE_KEY_MEDUSA=

# --- Cần cả lúc BUILD (bị ghi cứng vào storefront và trang admin Medusa) ---
CONFIG_API_MEDUSA_URL=
CONFIG_API_CHATBOT_URL=
CONFIG_SITE_URL=

# --- Storefront (.env.local) ---
MEDUSA_BACKEND_URL=
MEDUSA_PUBLISHABLE_KEY=
MEILI_HOST=
MEILI_MASTER_KEY=
MEILI_INDEX=products
TENANT_ID=
CHATBOT_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CHATBOT_WIDGET_KEY=
NEXT_PUBLIC_NH_TEN=
NEXT_PUBLIC_NH_STK=
NEXT_PUBLIC_NH_CHU_TK=
NEXT_PUBLIC_NH_BIN=
